<?xml version="1.0" ?>
<model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="model.xsd">
  <!-- MM_grammar: MentalModel composition mechanism fixture. Its
       default.grammar rules use product conjunction and probabilistic-sum
       disjunction (6.8 §12), with their free searched inverses. Codebook training
       is implicit when <codebook>quantize</codebook> is set
       (the <useVQVAE> knob was retired 2026-05-29). -->
  <architecture>
    <bindingDepth>3</bindingDepth>
    <data>
      <dataType>embedding</dataType>
    </data>
    <!-- Stage 1.E: grammar config (non-substrate rules below) — per-word
         forward dispatch via _forward_body_per_word. -->
    <conceptLayers>2</conceptLayers>

    <training>
      <numEpochs>400</numEpochs>
      <learningRate>0.01</learningRate>
      <reconstructionScale>0.1</reconstructionScale>
      <trainEmbedding>JOINT</trainEmbedding>
      <embeddingScale>0.05</embeddingScale>
      <autoload>false</autoload>
    </training>

  </architecture>

  <!-- 6.8 §22 declared capacity increase: event width 14 -> 22, hence
       content width 6 -> 14 after the four where and four when coordinates.
       Letter joins have more content coordinates; row capacities stay fixed. -->
  <InputSpace>
    <nDim>22</nDim>
    <nVectors>8</nVectors>
    <nOutput>8</nOutput>
  </InputSpace>

  <PartSpace>
    <nOutput>8</nOutput>
    <nDim>22</nDim>
    <nVectors>256</nVectors>
    <invertible>true</invertible>
  </PartSpace>

  <ConceptualSpace>
    <nOutput>8</nOutput>
    <nDim>22</nDim>
    <!-- §14 addendum: symbol/concept pairs only; letters stay in PS. -->
    <nVectors>8</nVectors>
    <invertible>true</invertible>
  </ConceptualSpace>

  <WholeSpace>
    <nOutput>8</nOutput>
    <nDim>22</nDim>
    <!-- The output-width override remains separate from the processing
         width above, which now has fourteen content coordinates. -->
    <nOutputDim>14</nOutputDim>
    <!-- WholeSpace is the upstream eight-class property inventory. Word,
         object, and META concepts are relation-only state owned downstream by
         ConceptualSpace; this fixture must not consume WS rows while parsing. -->
    <nVectors>9</nVectors>
  </WholeSpace>

  <OutputSpace>
    <nOutput>1</nOutput>
    <nVectors>1</nVectors>
  </OutputSpace>

  <SymbolSpace>
    <!-- Stage 3 cleanup: chartTau retired alongside the chart. The
         signal router (LanguageLayer) is the canonical parser. -->
    <language>
      <grammar>default.grammar</grammar>
    </language>
  </SymbolSpace>

</model>
