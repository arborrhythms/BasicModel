<?xml version='1.0' encoding='utf-8'?>
<model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="model.xsd">
  <!--Memory-bounded expectation benchmark after canonical W256 exceeded the default MPS allocator limit. Keep native space widths and dictionaries. Pack whole sentences into W64; exclude whole splitter records over 64 words, never truncate.-->
  <architecture>
    <serial>true</serial>
    <subsymbolicOrder>4</subsymbolicOrder>
    <conceptBinding>aligned</conceptBinding>
    <symbolicOrder>4</symbolicOrder>
    <syntacticOrder>0</syntacticOrder>
    <mereologyRaise>true</mereologyRaise>
    <serialObjectMeta>true</serialObjectMeta>
    <sentenceProtocol>false</sentenceProtocol>
    <serialWordCapacity>64</serialWordCapacity>
    <serialWordBuckets>64</serialWordBuckets>
    <serialResidualPartCapacity>64</serialResidualPartCapacity>
    <sigmaPi>butterfly</sigmaPi>
    <l1Lambda>0.01</l1Lambda>
    <transformChooser>mlp</transformChooser>
    <transformChooserHidden>0</transformChooserHidden>
    <transformChooserDepth>1</transformChooserDepth>
    <whatThinkingHidden>16</whatThinkingHidden>
    <whatThinkingDepth>1</whatThinkingDepth>
    <answerSynthesis>true</answerSynthesis>
    <synthesisBindings>4</synthesisBindings>
    <whatCurriculum>full</whatCurriculum>
    <whatCurriculumDistance>1</whatCurriculumDistance>
    <whatCurriculumRatio>0.25</whatCurriculumRatio>
    <categoryCodebook>true</categoryCodebook>
    <stmReduceTau>0.75</stmReduceTau>
    <learning>false</learning>
    <data>
      <dataType>embedding</dataType>
      <dataset>text</dataset>
      <shardDir>data/fineweb</shardDir>
      <contextWhole>FineWeb-Edu 100B shuffle</contextWhole>
      <numShards>1</numShards>
      <maxDocs>2000</maxDocs>
      <maxSentenceWords>64</maxSentenceWords>
    </data>
    <training>
      <numEpochs>1</numEpochs>
      <seed>42</seed>
      <batchSize>28</batchSize>
      <packSentences>true</packSentences>
      <numWorkers>2</numWorkers>
      <learningRate>0.0005</learningRate>
      <conceptualContextLearningRate>0.01</conceptualContextLearningRate>
      <conceptualContextNegatives>4</conceptualContextNegatives>
      <reconstructionScale>1.0</reconstructionScale>
      <teacherReconstruction>true</teacherReconstruction>
      <detachedReverse>true</detachedReverse>
      <leafDistillWeight>1.0</leafDistillWeight>
      <forwardGrammarWeight>0.0</forwardGrammarWeight>
      <sentenceExpectation>true</sentenceExpectation>
      <armaScale>0.0</armaScale>
      <intraLossWeight>0.0</intraLossWeight>
      <interLossWeight>0.1</interLossWeight>
      <interContrastiveWeight>0.0</interContrastiveWeight>
      <interContrastiveTemp>0.1</interContrastiveTemp>
      <autoload>false</autoload>
      <autosave>false</autosave>
      <checkpointEveryBatches>0</checkpointEveryBatches>
    </training>
    <weightsPath>BasicModel_expectation_benchmark.ckpt</weightsPath>
  </architecture>
  <InputSpace>
    <nOutput>8192</nOutput>
    <nVectors>256</nVectors>
    <nDim>512</nDim>
  </InputSpace>
  <PartSpace>
    <nInput>8192</nInput>
    <nInputDim>512</nInputDim>
    <nVectors>32768</nVectors>
    <maxVectors>1048576</maxVectors>
    <nDim>136</nDim>
    <nOutput>8</nOutput>
    <nOutputDim>136</nOutputDim>
    <invertible>true</invertible>
    <synthesis>meronomy</synthesis>
    <chunkPromotionThreshold>2</chunkPromotionThreshold>
  </PartSpace>
  <ConceptualSpace>
    <conceptReadoutL1>0.01</conceptReadoutL1>
    <nInput>8</nInput>
    <nInputDim>1032</nInputDim>
    <nVectors>1048576</nVectors>
    <activeVectors>32768</activeVectors>
    <stmCapacity>8</stmCapacity>
    <nDim>1032</nDim>
    <nOutput>8</nOutput>
    <nOutputDim>1032</nOutputDim>
    <invertible>true</invertible>
  </ConceptualSpace>
  <WholeSpace>
    <propertyBasis>true</propertyBasis>
    <analysis>meronomy</analysis>
    <butterfly>true</butterfly>
    <nInput>8</nInput>
    <nInputDim>1032</nInputDim>
    <nVectors>8</nVectors>
    <nDim>136</nDim>
    <nOutput>8</nOutput>
    <nOutputDim>136</nOutputDim>
    <invertible>true</invertible>
  </WholeSpace>
  <OutputSpace>
    <nInput>8</nInput>
    <nInputDim>1032</nInputDim>
    <nVectors>1</nVectors>
    <nDim>1</nDim>
    <nOutput>1</nOutput>
    <nOutputDim>1</nOutputDim>
  </OutputSpace>
  <SymbolSpace>
    <language>
      <grammar>complete.grammar</grammar>
    </language>
  </SymbolSpace>
</model>