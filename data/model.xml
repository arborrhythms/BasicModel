<?xml version="1.0" ?>
<!--
  model.xml — canonical defaults for BasicModel.

  Every parameter that create_from_config() reads must appear here.
  Model-specific XML files (XOR_exact.xml, BasicModel.xml, …) override
  individual values; anything they omit inherits from this file.

  Sentinels:
    nInput=0   InputSpace: derive from TheData; other spaces: derive
               from the previous space's outputShape[0].
    nOutput=0  Same as nInput for this space (passthrough count).
    nVectors=0 Same as nOutput (used for non-codebook spaces).
-->
<model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="model.xsd">
  <architecture>
    <!-- Mental age in years before the first assessment. -->
    <age>0</age>
    <separateChooser>false</separateChooser>
    <reconstructionJitter>0</reconstructionJitter>
    <explorePaths>1</explorePaths>
    <!-- One logit unit and one path-cost unit per kept operator application. -->
    <operatorCost>1</operatorCost>
    <!-- Path-cost units per step for the working-memory load left, as a
         fraction of the allowance; the chooser reads the rounds left. -->
    <reductionCost>1</reductionCost>
    <interpretBias>1</interpretBias>
    <!-- The probability that a look over a run of words takes the idea the
         basic level reads from it as one constituent. -->
    <fragmentBias>0</fragmentBias>
    <!-- The pairs of words a sentence may tie (WordTies). -->
    <wordTieCapacity>256</wordTieCapacity>
    <!-- The candidate entries held at a look, and the penalty on each. -->
    <candidateCapacity>64</candidateCapacity>
    <candidatePenalty>0.2</candidatePenalty>
    <!-- The least value at which a structure is read. -->
    <structureReadThreshold>0.001</structureReadThreshold>
    <!-- The rows of the table a look presents: the attended percepts. -->
    <attendedPercepts>256</attendedPercepts>
    <!-- The input's reconstruction, leaf by leaf: the sharpness of the match
         of a recreated .what against the percept codebook (on the cosine),
         and of a leaf's .where wires against the grid (on the distance). -->
    <reconstructionWhatSharpness>50</reconstructionWhatSharpness>
    <reconstructionWhereSharpness>1000</reconstructionWhereSharpness>
    <omissionTarget>0.9</omissionTarget>
    <omissionLimit>0.5</omissionLimit>
    <omissionHorizon>1024</omissionHorizon>
    <!-- Fixed trips per free output or sentence-decoder walk. -->
    <generateBudget>32</generateBudget>
    <!-- Raw bytes in one word; lexical tables reserve EOS separately. -->
    <wordSurfaceCapacity>64</wordSurfaceCapacity>
    <!-- Cued retrieval scores this many recent candidates, then returns top-K. -->
    <ltmWindow>1024</ltmWindow>
    <!-- LTM retention: bounded age and value choose rows under capacity pressure. -->
    <forgetting>true</forgetting>
    <forgetHighWater>0.9</forgetHighWater>
    <forgetLowWater>0.7</forgetLowWater>
    <forgetMinInterval>256</forgetMinInterval>
    <forgetAtEpoch>false</forgetAtEpoch>

    <!-- The data tier (embedding | numeric) is set under <data> as
         <dataType>; this defaults file uses numeric (see <data> below). -->

    <!-- Iteration depth of the P→C→S pipeline.  order > 1 partitions
         the symbolic codebook geometrically (see Reasoning.md). -->
    <bindingDepth>1</bindingDepth>
    <!-- Sentence word bound and pinned construction-bank size for every model. -->
    <serialWordCapacity>256</serialWordCapacity>

    <!-- Stage 1.E (doc/plans/2026-05-26-two-loop-pi-sigma-substrate.md):
         <serial> selects the per-word grammatical body. It is omitted here
         so legacy configs keep deriving the mode from symbolicOrder > 0.
         New configs should set  explicitly. -->
    <!--  -->

    <!-- Hard compose sampling only; zero selects exact-logit argmax.
         Both training derivations use this temperature. Model softmax
         probabilities used for gradient credit remain untempered. -->
    <composeTemperature>0</composeTemperature>

    <!-- symbolicOrder is the symbolic / relational loop budget, not the
         primary mode selector. Omitted here so legacy configs inherit the
         grammar-derived default: 1 when the XML enables a non-substrate rule
         (useGrammar != 'none'), else 0. Concrete configs should set this
         explicitly when they need a symbolic loop limit. -->
    <conceptLayers>2</conceptLayers>

    <!-- Concept rows compose by union. Pool participation is an EWMA of use. -->
    <attentionPromotion>false</attentionPromotion>
    <conceptMintCount>3</conceptMintCount>
    <conceptUseFloor>0.5</conceptUseFloor>
    <conceptMatchPart>1.0</conceptMatchPart>
    <conceptPartFloor>0.001</conceptPartFloor>

    <!-- Task 4 (doc/plans/2026-05-29-stm-serial-parallel-modes.md §4):
         per-word router-fire gating for serial mode.
           per-word  = fire symbolSpace.compose once per word in the
                       serial per-word loop (the intra-predictor's
                       routing context); boundary fire OFF.
           boundary  = fire only at the sentence boundary
                       (_chart_compose_at_C / _chart_generate_from_stm);
                       the inter-sentence predictor's routing snapshot.
           both      = (DEFAULT) per-word during training so the
                       intra-predictor sees routing context, AND boundary
                       still fires for the inter-sentence predictor.
           off       = neither fires.
         Default ``both`` preserves the pre-existing boundary-fire
         behaviour. -->
    <routerWireSerial>both</routerWireSerial>

    <!-- Chooser capacity, independent of parsing/episode iteration budgets.
         Grammar hidden=0 derives max(8, grammar feature width). Depth is the
         number of hidden Linear/GELU blocks before the scalar score. -->
    <transformChooserHidden>0</transformChooserHidden>
    <transformChooserDepth>1</transformChooserDepth>
    <whatThinkingHidden>16</whatThinkingHidden>
    <whatThinkingDepth>1</whatThinkingDepth>
    <intuitionCapacity>4096</intuitionCapacity>
    <!-- One completed selected grammatical question owns this many shared
         controller/query-work units. Policy sampling remains separately off. -->
    <attentionBudget>32</attentionBudget>
    <!-- Retain both overlapping meaning lanes at the mask input. -->
    <hetTolerance>1</hetTolerance>
    <!-- attend's read of the conceptual field (rule 80): its rectified
         units, shared by the request, the stop and the word said; and the
         sharpness of a look's softmax share over the unread words. -->
    <requestReadWidth>64</requestReadWidth>
    <!-- The request's start on every concept, as log-odds: small, so that
         no occurrence's share is held at its own activity and the request
         is taught from the first look. -->
    <requestReadStart>-4</requestReadStart>
    <thoughtSearchExhaustion>1</thoughtSearchExhaustion>

    <!-- Reverse from the idea rather than replaying the forward grammar trace.
         When true, reverse() clears current_rules/generate_rules and the
         router's last route, then asks SymbolSpace.generate() to infer a fresh
         reverse rule path from the supplied idea snapshot. -->
    <reconstructFromIdea>false</reconstructFromIdea>

    <!-- Construct answers through the separate output() path (resolve ->
         conceptual synthesis -> perceptual synthesis -> OutputSpace adapter)
         rather than the direct symbol projection. Off until the temporal /
         supervised curriculum trains the synthesis adapter. -->
    <answerSynthesis>false</answerSynthesis>
    <synthesisBindings>0</synthesisBindings>
    <whatCurriculum>none</whatCurriculum>
    <whatCurriculumDistance>1</whatCurriculumDistance>
    <whatCurriculumRatio>0.25</whatCurriculumRatio>

    <!-- Apply extra symbolic processing steps after Sigma. -->
    <processSymbols>false</processSymbols>

    <!-- Meronomy (MeronomySpec, doc/plans/): "on" binds the meronymic
         slots (PS.sigma / WS.pi) to the membership kernels
         (SigmaLayer2 / PiLayer2 via the membership-native adapter), enables the
         interface factoring at the callosum, the reference-half
         pole-quotient lookup, and the word/object binding table.
         Stage 9 cutover flipped this default to "on" (2026-06-11);
         set "off" per model to keep the legacy odds-path slots.
         dMaxStable bounds the complete learned fold's inverse gain. -->
    <meronomy dMaxStable="4.0">on</meronomy>

    <!-- Constrain invertible Sigma / Pi to W ≥ 0 so the lift / lower
         chain is order-preserving on the parthood cone (Spaces.md). -->
    <monotonic>false</monotonic>

    <!-- Ergodic exploration: every Layer uses
         W_eff = bias * W + temp * noise. -->
    <ergodic>false</ergodic>

    <!-- Materialise W_eff densely in InvertibleLinearLayer (slower;
         debugging only).  False uses sequential L/D/U triangular solves. -->
    <naive>false</naive>

    <!-- Positional / temporal encoding dimensions appended to each
         vector.  > 0 enables PositionalEncoding / TemporalEncoding
         across the whole model. -->

    <!-- gensim KeyedVectors path; empty disables embedding load. -->
    <embeddingPath></embeddingPath>
    <!-- Checkpoint path for the neural model weights. -->
    <weightsPath></weightsPath>

    <!-- Inference token budget (characters / bytes / tokens).  Caps
         output alongside InputSpace.nActive. -->
    <maxResponseLength>4096</maxResponseLength>

    <!-- AMP autocast mode: off | fp16 | bf16. -->
    <amp>off</amp>

    <!-- TruthLayer integration (see Reasoning.md, Ethics.md).
         truthBiasScale: luminosity bias on concept input during forward.
         LuminosityWeight: multiplicative loss penalty for incoherent truths.
         UniversalityWeight: multiplicative loss penalty for unkind props. -->
    <truthBiasScale>0.1</truthBiasScale>
    <LuminosityWeight>0.1</LuminosityWeight>
    <UniversalityWeight>0.1</UniversalityWeight>

    <!-- Quaternary-corner balance (catuskoti / tetralemma).
         allowExcludedMiddle:  1=permit NEITHER (default), -1=classical LEM
         allowContradiction:   0=forbid BOTH (default), 1=paraconsistent
         See Philosophy.md for the 4-valued truth semantics. -->
    <allowExcludedMiddle>1</allowExcludedMiddle>
    <allowContradiction>0</allowContradiction>

    <!-- L1 sparsity penalty on lift / lower gates.  Opt-in; 0 disables. -->
    <gateL1Lambda>0.0</gateL1Lambda>

    <!-- Sparse-MoE load-balance loss weight (Shazeer et al. 2017).
         Originally active only when SymbolSpace.chartTopK > 0; chart
         retired Stage 3 and the knob now stands by for any future
         signal-router rule load-balancing. -->
    <loadBalanceWeight>0.0</loadBalanceWeight>

    <!-- Read by the configuration diagnostic for discontinuity. -->
    <discontinuityLambda>0.0</discontinuityLambda>

    <!-- Passes allowed to retarget perception: all, off, or indices 1..T-1. -->

    <!-- Completed learning updates without improved local both evidence,
         before discontiguous support may raise conceptual order. -->
    <mereologyRefinePatience>3</mereologyRefinePatience>
    <maxActivePerLayer>8</maxActivePerLayer>
    <!-- Role-participation category codebook for the role-collapsed grammar.
         Unsettled MetaSymbols accumulate bounded temporary role evidence, then
         commit to one role-space category id used by all transform choosers. -->
    <!-- Experimental overlapping PS/WS .where lattice. Requires
         mereologyRaise=true; stays false until its corpus gates pass. -->
    <codebookRetire>false</codebookRetire>

    <!-- Model-level trust multiplier for incoming assertions/testimony.
         Effective signed DoT = <trust> * incoming trust. Default 1.0 keeps
         configured/runtime trust values literal. -->
    <trust>1.0</trust>

    <!-- Runtime symbol-learning hooks. Disabled by default. -->
    <symbolLearning>
      <enabled>false</enabled>
    </symbolLearning>

    <!-- How a concept row is bound (mixing | aligned), and whether a
         concept is read by its index. -->
    <conceptBinding>mixing</conceptBinding>
    <conceptIndexRead>false</conceptIndexRead>
    <!-- The continuity cost of a whole's parts: its norm, the ratio it
         aims at, and its sharpness. -->
    <continuityNorm>inf</continuityNorm>
    <continuityRatioTarget>1.0</continuityRatioTarget>
    <continuitySharpness>1.0</continuitySharpness>
    <mereologyRaise>false</mereologyRaise>
    <modifierEigEdit>false</modifierEigEdit>
    <verbSpectrum>false</verbSpectrum>
    <predictionTrialRatio>0.0</predictionTrialRatio>
    <primingDecay>0.9</primingDecay>
    <queryReasoning>false</queryReasoning>
    <radialStmReduce>false</radialStmReduce>
    <serialObjectMeta>false</serialObjectMeta>
    <serialResidualPartCapacity>16</serialResidualPartCapacity>
    <!-- Empty: one bucket of serialWordCapacity words. -->
    <serialWordBuckets></serialWordBuckets>
    <sigmaPi>butterfly</sigmaPi>
    <stateless>true</stateless>
    <!-- Parse-tree depth cap of the serial reduction; 0 = unbounded. -->
    <syntacticOrder>0</syntacticOrder>
    <writeSyntax>false</writeSyntax>
    <syntaxOutPath>output/syntax.xml</syntaxOutPath>
    <whatThinkingDetach>slot</whatThinkingDetach>
    <whatThinkingIterations>1</whatThinkingIterations>
    <whatThinkingPressure>linear</whatThinkingPressure>
    <!-- Ratio between the two rungs of the .where code. -->
    <whereRungRatio>32</whereRungRatio>
    <!-- The axes of the .where: a place is (x, y, z), each axis four
         wires of the two-rung ladder; text lies on the first axis. -->
    <whereAxes>3</whereAxes>

    <data>
      <dataType>numeric</dataType>
      <!-- Dataset key: xor | mnist | tomatoes | text | inline.
           Omit for inference-only models. -->
      <dataset>xor</dataset>
      <!-- Optional primitive/name teaching examples for concept-id outputs. -->
      <conceptLessons></conceptLessons>
      <readingOrderLesson></readingOrderLesson>
      <!-- Shard count and per-shard document cap (streaming datasets). -->
      <numShards>1</numShards>
      <maxDocs>10000</maxDocs>
      <!-- Directory containing text shards (e.g. data/fineweb). -->
      <shardDir></shardDir>
      <!-- Vocabulary admission threshold (fraction of corpus).
           0.0 admits all words immediately. -->
      <minFrequency>0.0</minFrequency>
      <!-- Empty: the context whole is named from the dataset. -->
      <contextWhole></contextWhole>
      <grammarLessons>grammar_wording.json</grammarLessons>
      <!-- 0: no bound on a sentence's words. -->
      <maxSentenceWords>0</maxSentenceWords>
    </data>

    <training>
      <!-- Order-one sparse components; admission requires four witnesses. -->
      <independenceWeight>0.1</independenceWeight>
      <independencePriorScale>0.05</independencePriorScale>
      <independenceMintThreshold>0.2</independenceMintThreshold>
      <!-- Number of independent training runs per invocation. -->
      <numTrials>1</numTrials>
      <!-- Training epochs per trial. -->
      <numEpochs>3</numEpochs>
      <!-- Contiguous streams through the dataset; each row b receives
           the next item from stream b so context stays coherent. -->
      <batchSize>64</batchSize>
      <!-- DataLoader prefetch workers; 0 = synchronous in-process. -->
      <numWorkers>0</numWorkers>
      <actionRateRatio>1</actionRateRatio>
      <!-- Adam learning rate. -->
      <learningRate>0.001</learningRate>
      <connectiveLearningRate>.1</connectiveLearningRate>
      <connectiveFitSteps>500</connectiveFitSteps>
      <connectiveFitSeed>0</connectiveFitSeed>
      <wordPretrainLearningRate>.01</wordPretrainLearningRate>
      <embeddingLearningRate>.001</embeddingLearningRate>
      <sbowLearningRate>.01</sbowLearningRate>
      <decisionBoundaryLearningRate>.01</decisionBoundaryLearningRate>
      <memLearningRate>.01</memLearningRate>
      <symPerceptLearningRate>.001</symPerceptLearningRate>
      <spnnLearningRate>.05</spnnLearningRate>
      <sigmaPiLearningRate>.01</sigmaPiLearningRate>
      <!-- Teacher owns clean reconstruction lessons when enabled. -->
      <teacherReconstruction>false</teacherReconstruction>
      <!-- Supplied grammar annotations train the existing grammar MLPs.
           Unlabelled corpora have no grammar-lesson objective. -->
      <grammarLessonWeight>1.0</grammarLessonWeight>
      <!-- Independent priority of each relative reconstruction term.
           Answer terms retain their own event-band priorities. -->
      <reconstructionScale>0.5</reconstructionScale>
      <!-- Per-channel triple loss scales (what / where / when). -->
      <whatScale>0.7</whatScale>
      <whereScale>0.2</whereScale>
      <whenScale>0.1</whenScale>
      <!-- Negative samples per positive for CBOW / SBOW training. -->
      <negSamples>64</negSamples>
      <!-- Additive penalty for propositions contradicting the TruthSet;
           uses union-norm reduction.  0 disables. -->
      <TruthLoss>0.0</TruthLoss>

      <!-- Within-sentence training is IR-only (masked-LM at the P-tier).
           IR-mode Bernoulli probability that a percept is replaced by
           NULL_PERCEPT.  Range [0,1]; BERT default 0.15. -->
      <maskRate>0.15</maskRate>

      <!-- Embedding update mode:
           NONE | CBOW | SBOW | BACKPROP | BOTH | JOINT. -->
      <trainEmbedding>NONE</trainEmbedding>
      <!-- Embedding co-occurrence loss weight λ in JOINT mode. -->
      <embeddingScale>0.25</embeddingScale>

      <!-- Load weights from weightsPath at construction. Training configs
           default to true so runs resume from existing checkpoints; stale
           incompatible checkpoints fail fast and should be moved/deleted
           or regenerated. -->
      <autoload>true</autoload>
      <!-- Persist weights when training completes. -->
      <autosave>false</autosave>
      <!-- Mid-training checkpoint cadence (optimizer steps).  0 disables. -->
      <checkpointEveryBatches>0</checkpointEveryBatches>
      <!-- cProfile the training loop. -->
      <profile>false</profile>
      <!-- Per-neuron certainty tracking in ergodic layers. -->
      <certainty>false</certainty>

      <!-- One shared native activation predictor, with local detached E. -->
      <sentenceExpectation>true</sentenceExpectation>
      <perceptExpectationGain>0</perceptExpectationGain>
      <symbolExpectationGain>0</symbolExpectationGain>
      <expectationOmissionThreshold>0.5</expectationOmissionThreshold>
      <perceptExpectationRate>0.05</perceptExpectationRate>
      <expectationEpsilon>0.000001</expectationEpsilon>
      <expectationSaturation>clip</expectationSaturation>
      <expectationPrime>true</expectationPrime>
      <explorationUniformFraction>0.5</explorationUniformFraction>
      <explorationTemperature>1.0</explorationTemperature>


      <!-- Shared bank-activation predictor: sources and targets are detached;
           the local residual alone trains its weights. -->
      <symbolFieldLossWeight>0.1</symbolFieldLossWeight>
      <wordExpectation>true</wordExpectation>
      <wordExpectationLossWeight>0.1</wordExpectationLossWeight>
      <reconstructionBasisLimit>16</reconstructionBasisLimit>
      <!-- graph | compiled | eager. -->
      <reconstructionPlacement>graph</reconstructionPlacement>
      <reconstructInLoop>false</reconstructInLoop>
      <outputInLoop>false</outputInLoop>
      <packSentences>false</packSentences>
      <equalityLossWeight>0.0</equalityLossWeight>
      <thinkingLossWeight>0.0</thinkingLossWeight>
      <whatThinkingPolicyWeight>0.0</whatThinkingPolicyWeight>
      <leafDistillWeight>0.0</leafDistillWeight>
      <conceptualContextLearningRate>0.0</conceptualContextLearningRate>
      <!-- 0 disables the diagnostics and the interval log. -->
      <branchDiagnosticsEvery>0</branchDiagnosticsEvery>
      <intervalLogEveryBatches>0</intervalLogEveryBatches>
      <!-- Empty: output/intervals.jsonl. -->
      <intervalLogFile></intervalLogFile>
      <!-- Empty: the random streams are not seeded. -->
      <seed></seed>
      <!-- Hard normal grammatical-thought choices use their own explicit
           REINFORCE credit; zero preserves the deterministic safe baseline. -->
    </training>

    <server>
      <!-- HTTP serve.py bind address. -->
      <host>127.0.0.1</host>
      <!-- HTTP serve.py port (override per model to run in parallel). -->
      <port>8001</port>
      <!-- Per-request timeout in seconds. -->
      <timeout>120</timeout>
    </server>

  </architecture>

  <SymbolSpace>
    <!-- SyntacticLayer MLP hidden size (prev hardcoded 64..256). -->
    <syntacticHiddenDim>64</syntacticHiddenDim>

    <!-- Truth memory capacity (TruthLayer is owned by SymbolSpace). -->
    <truthMaxEntries>1024</truthMaxEntries>

    <!-- Long-term-memory (LTM) chain capacity (InterSentenceLayer):
         bounds the per-row chain of STM end-states (the AR sequence
         used for inter-sentence prediction).  Separate from
         <truthMaxEntries>.  Default 1024. -->
    <ltmCapacity>1024</ltmCapacity>
    <episodicConcepts>4</episodicConcepts>
    <relationCapacity>8192</relationCapacity>
    <equalityWitnessCapacity>8192</equalityWitnessCapacity>

    <!-- Stage 3 cleanup (2026-05-27): the chart and STM shift-reduce
         parsers retired in favour of the signal router (LanguageLayer).
         The retired knobs (parserBackend, routerKind, chartTau,
         chartTopK, chartNoiseEps) raise a loud ValueError at
         config load time. See
         Language._assert_retired_chart_knobs_absent. -->

    <!-- Phase D: emit a codebook head via SymbolSpace.reconstruct().
         false = forward() does not populate ``_predicted_head``. -->
    <downwardGeneration>false</downwardGeneration>

    <language>
      <start>S</start>
      <grammar>
        <!-- Default grammar: trivial unary pi / sigma folds at every
             tier.  PiLayer and SigmaLayer are first-class arity=1
             GrammarLayer subclasses; their forward(x) is the
             always-on multiplicative AND-fold (concepts) and OR-fold
             (percepts / symbols) respectively.

             A grammar containing only these unary rules is the
             "default-only" case: SymbolSpace.compose detects it and
             skips parser selection entirely.

             Per the 2026-05-07 rollback, the grammar XML is the sole
             source of truth for which rule fires at each tier.  There
             is no ``default_rule`` code-level fallback.  SymbolSpace
             populates ``current_rules`` / ``generate_rules`` from the
             rules listed below in the default-only fast path so per-space SyntacticLayer
             dispatch resolves to the PiLayer / SigmaLayer registered
             at space construction.  End-to-end cost matches the legacy
             y = self.pi(x) call site.

             Configs that need real grammar (constituency / negation /
             min-max ops) override this entire block via
             _NON_MERGING_PATHS (util.py); their grammar block fully
             replaces this one.  Configs that previously relied on the
             default_rule code-level fallback for sigma / pi at any
             tier need explicit ``S = sigma(S)``, ``C = pi(C)``,
             ``P = sigma(P)`` (and matching ``.reverse`` rules)
             listed; otherwise the per-tier dispatch is a no-op. -->
        <compose>
      <!-- Typed attention candidates; no predefined surface or generate face. -->
      <rule operands="field">F = intersection.forward(F)</rule>
      <rule operands="field">F = union.forward(F)</rule>
      <rule operands="field">F = not.forward(F)</rule>

          <percepts>
            <rule>P = sigma(P)</rule>
          </percepts>
          <concepts>
            <rule>C = pi(C)</rule>
          </concepts>
          <symbols>
            <rule>S = sigma(S)</rule>
          </symbols>
        </compose>
        <generate>
          <percepts>
            <rule>P = sigma.reverse(P)</rule>
          </percepts>
          <concepts>
            <rule>C = pi.reverse(C)</rule>
          </concepts>
          <symbols>
            <rule>S = sigma.reverse(S)</rule>
          </symbols>
        </generate>
      </grammar>
      <!-- Soft-interpolation weight between forward and generation. -->
      <interpretation>0.5</interpretation>
      <!-- The grammar's rules available at the start, by name, separated
           by spaces: "*" is every rule, empty is none. A rule that is not
           available is on neither the compose chooser's menu nor the
           walk's; the curriculum makes the rules available one at a time
           as they are taught (LanguageSpace.make_available), and the
           availabilities are saved with the model. -->
      <rulesAvailable>*</rulesAvailable>
    </language>
  </SymbolSpace>


  <InputSpace>
    <!-- Sequence-length sentinels; create_from_config() resolves
         nOutput=0 -> data-derived; nInput=0 -> data-derived. -->
    <nInput>0</nInput>
    <nOutput>0</nOutput>
    <!-- Per-vector EVENT width (it embraces the .where/.when band: content
         nWhat = nDim - nWhere - nWhen). Muxed tier default 17 = 1 content + 12
         .where + 4 .when. -->
    <nDim>17</nDim>
    <!-- Raw data dims; 0 = use the loader's native dim. -->
    <nInputDim>0</nInputDim>
    <nOutputDim>0</nOutputDim>
    <!-- Codebook size; 0 means defer to nOutput. -->
    <nVectors>0</nVectors>
    <!-- Discrete (codebook) input values. -->
    <codebook>none</codebook>
    <demuxed>false</demuxed>
    <!-- Tokenization for text inputs: word | sentence | byte. -->
    <!-- raw: InputSpace emits the unanalyzed [B,1,N] byte buffer; the
         meronymic analyzer (chunking=analyse, the default) owns all
         tokenization. Non-analyse models (radix/bpe/lexicon) pin their own
         lexer (byte/word) so they keep the pre-lexed buffer. -->
  </InputSpace>

  <PartSpace>
    <identityByParts>true</identityByParts>
    <basicPerceptCapacity>262144</basicPerceptCapacity>
    <identityPairDim>64</identityPairDim>
    <identityOnes>3</identityOnes>
    <propertyDim>64</propertyDim>
    <propertyOnes>3</propertyOnes>
    <nInput>0</nInput>
    <nOutput>0</nOutput>
    <!-- EVENT width (embraces .where/.when); content nWhat = nDim - 16. -->
    <nDim>17</nDim>
    <nInputDim>0</nInputDim>
    <nOutputDim>0</nOutputDim>
    <nVectors>0</nVectors>
    <!-- Attention reweighting of percepts before the Pi fold. -->
    <hasAttention>false</hasAttention>
    <!-- Shared invertible PiLayer (vs separate pi1 / pi2). -->
    <invertible>false</invertible>
    <!-- Tanh-bound the output to [-1, 1]. -->
    <nonlinear>true</nonlinear>
    <!-- PartSpace is subsymbolic: the <codebook> element was retired
         (2026-06-09, asymmetric-VQ plan §7 task 7). PS is hardwired to "none"
         (continuous .event passthrough; percept prototypes live on the .what
         Embedding). Only WholeSpace carries a <codebook>. -->
    <!-- Synthesis (bottom-up union) strategy: lexicon | bpe | mphf | byte/none | radix | meronomy.
         Phase 4b default: lexicon (word resolution through the word
         codebook - the closest surviving mode to the retired PS analyse;
         the meronymic analyzer is ANALYSIS and lives on WholeSpace as
         <analysis>meronomy). -->
    <synthesis>meronomy</synthesis>
    <!-- BPE merges per chunking pass (lexicon mode ignores this). -->
    <wordLearning>2</wordLearning>
    <!-- Radix promotion: the count and the least length of a chunk. -->
    <chunkPromotionThreshold>4</chunkPromotionThreshold>
    <chunkPromotionMinLength>2</chunkPromotionMinLength>
    <!-- Reverse-retrieval attention: off | primer | second-order | low-rank. -->
    <attention>off</attention>
    <codebookGrowthEpsilon>0.0</codebookGrowthEpsilon>
  </PartSpace>

  <ModalSpace>
    <nInput>0</nInput>
    <nOutput>0</nOutput>
    <!-- EVENT width (embraces .where/.when); content nWhat = nDim - 16. -->
    <nDim>17</nDim>
    <nInputDim>0</nInputDim>
    <nOutputDim>0</nOutputDim>
    <nVectors>0</nVectors>
    <!-- Modal-channel attention. -->
    <hasAttention>false</hasAttention>
    <!-- Shared invertible layer for the modal mux / demux. -->
    <invertible>false</invertible>
    <!-- Codebook quantization on the modal output. -->
    <codebook>none</codebook>
  </ModalSpace>

  <ConceptualSpace>
    <!-- The observed basic field learns the kept sentence idea. -->
    <ideaHidden>64</ideaHidden>
    <ideaLayers>1</ideaLayers>
    <!-- Active bipolar complement. Zero disables meaning; storage geometry stays fixed. -->
    <meaningWidth>128</meaningWidth>
    <placementRate>0.1</placementRate>
    <objectStartNeighbours>3</objectStartNeighbours>
    <placementNegatives>5</placementNegatives>
    <placementNegativeWeight>1.0</placementNegativeWeight>
    <!-- Zero retains the complete bridge reservation; a positive capacity
         bounds the sparse 32-destination blocks and raises on exhaustion.
         The lesser of this and the complete reservation is held. -->
    <primingBridgeCapacity>8388608</primingBridgeCapacity>
    <raiseEvidence>0</raiseEvidence>
    <raiseCount>3</raiseCount>
    <trustViews>3</trustViews>
    <definitionTrust>0.5</definitionTrust>
    <mtmPrepend>64</mtmPrepend>
    <readerBlockNormalization>true</readerBlockNormalization>
    <!-- Deterministic room between the part and property-whole bounds. -->
    <latticeMargin>0</latticeMargin>
    <nInput>0</nInput>
    <nOutput>0</nOutput>
    <!-- EVENT width (embraces .where/.when); content nWhat = nDim - 16. -->
    <nDim>17</nDim>
    <nInputDim>0</nInputDim>
    <nOutputDim>0</nOutputDim>
    <nVectors>0</nVectors>
    <!-- Attention on ConceptualSpace violates position locality
         required by serial_mode; keep false unless a config opts in. -->
    <hasAttention>false</hasAttention>
    <!-- Shared invertible SigmaLayer (vs separate sigma1 / sigma2). -->
    <invertible>false</invertible>
    <!-- Tanh-bound the output to [-1, 1]. -->
    <nonlinear>true</nonlinear>
    <!-- Codebook quantization of concept directions. -->
    <codebook>none</codebook>
    <!-- 0: every allocated concept row is active. -->
    <activeVectors>0</activeVectors>
    <!-- The live depth of the reducing STM, not a sentence-length limit. -->
    <stmCapacity>8</stmCapacity>
    <mtmCapacity>64</mtmCapacity>
    <mtmHorizon>16</mtmHorizon>
    <orderAllocation>geometric</orderAllocation>
    <intuitHidden>64</intuitHidden>
    <intuitLayers>1</intuitLayers>
    <markerKernels>8</markerKernels>
    <markerHidden>64</markerHidden>
    <markerLayers>2</markerLayers>
    <verbGroups>24</verbGroups>
    <verbBasisReflections>4</verbBasisReflections>
    <verbGroupFit>0.1</verbGroupFit>
    <definitionFreeSize>2</definitionFreeSize>
    <utilitySmoothing>1.0</utilitySmoothing>
    <utilityMinCount>4</utilityMinCount>
    <utilityPriorRate>1.0</utilityPriorRate>
    <admissionCount>2</admissionCount>
    <!-- 0: the square root of WholeSpace.lbgThreshold. -->
    <admissionRadius>0</admissionRadius>
    <attention>off</attention>
    <codebookGrowthEpsilon>0.0</codebookGrowthEpsilon>
  </ConceptualSpace>

  <WholeSpace>
    <analysis>meronomy</analysis>
    <!-- The WholeSpace cut is <analysis> (the unified knob; raw is the
         resolve_lexer default when unset). <lexer>/<analyzer> are deprecated. -->
    <nInput>0</nInput>
    <nOutput>0</nOutput>
    <!-- symbol_dim must equal concept_dim under the ownership rule
         (WholeSpace owns no SigmaLayer/PiLayer). nDim=0 means
         "inherit from ConceptualSpace.nDim". Concrete configs may set
         a positive value, but it must match ConceptualSpace.nDim. -->
    <nDim>0</nDim>
    <nInputDim>0</nInputDim>
    <nOutputDim>0</nOutputDim>
    <nVectors>0</nVectors>
    <!-- Tanh-bound the symbolic activation. -->
    <nonlinear>true</nonlinear>
    <!-- Discrete symbol prototypes (required for the full symbolic
         pipeline). Mandatory in the converged modality architecture
         (WholeSpace is a MANDATORY_CODEBOOK_TIER). -->
    <codebook>quantize</codebook>
    <!-- L1 sparsity penalty on the symbolic activation. -->
    <l1Lambda>0.01</l1Lambda>
    <commitmentBeta>0.25</commitmentBeta>
    <!-- Enable VQ-VAE-style quantization rather than EMA codebook. -->
    <invertible>false</invertible>
    <butterfly>false</butterfly>
    <lbgThreshold>0.5</lbgThreshold>
    <divideWithinWhole>true</divideWithinWhole>
    <digitWholes>false</digitWholes>
    <boundaryTypes>canonical</boundaryTypes>
    <whitespaceUnits>false</whitespaceUnits>
    <boundaryLearningRate>0.0</boundaryLearningRate>
    <boundaryDensityWeight>0.05</boundaryDensityWeight>
    <boundaryUpdateEvery>32</boundaryUpdateEvery>
    <boundaryTypeWeight>0.25</boundaryTypeWeight>
    <!-- 0: the unit seed of the codebooks. -->
    <initScale>0</initScale>
    <attention>off</attention>
    <codebookGrowthEpsilon>0.0</codebookGrowthEpsilon>
  </WholeSpace>

  <OutputSpace>
    <!-- Space-separated persistent concept ids; each reads its positive pole. -->
    <nInput>0</nInput>
    <nOutput>0</nOutput>
    <nDim>1</nDim>
    <nInputDim>0</nInputDim>
    <nOutputDim>0</nOutputDim>
    <nVectors>0</nVectors>
    <!-- Invertible projection (rarely set on OutputSpace). -->
    <invertible>false</invertible>
    <!-- Codebook quantization of the output. -->
    <codebook>none</codebook>
    <!-- Linear (no tanh) output; OutputSpace rescales via Data.denormalize. -->
    <nonlinear>false</nonlinear>
    <lrScale>1.0</lrScale>
  </OutputSpace>

</model>
