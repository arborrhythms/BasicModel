<?xml version='1.0' encoding='utf-8'?>
<model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="model.xsd">
  <architecture>
    <omissionTarget>1</omissionTarget>
    <bindingDepth>2</bindingDepth>
    <conceptLayers>2</conceptLayers>
    <conceptualPi>true</conceptualPi>
    <attentionPromotion>true</attentionPromotion>
    <symbolTower>true</symbolTower>
    <conceptBinding>aligned</conceptBinding>
    <data>
      <dataType>numeric</dataType>
      <dataset>xor</dataset>
    </data>
    <training>
      <autoload>false</autoload>
      <numEpochs>64</numEpochs>
      <learningRate>0.03</learningRate>
      <maskRate>0</maskRate>
      <reconstructionScale>0.1</reconstructionScale>
      <trainEmbedding>JOINT</trainEmbedding>
      <embeddingScale>0.05</embeddingScale>
    </training>
  </architecture>
  <InputSpace>
    <nVectors>2</nVectors>
    <nDim>9</nDim>
    <nOutput>2</nOutput>
    <nOutputDim>9</nOutputDim>
  </InputSpace>
  <PartSpace>
    <nInputDim>9</nInputDim>
    <nInput>16</nInput>
    <nVectors>256</nVectors>
    <basicPerceptCapacity>256</basicPerceptCapacity>
    <nDim>16</nDim>
    <nOutput>16</nOutput>
    <invertible>true</invertible>
    <synthesis>meronomy</synthesis>
    <butterfly>false</butterfly>
    <chunkPromotionThreshold>2</chunkPromotionThreshold>
  </PartSpace>
  <ConceptualSpace>
    <nInput>16</nInput>
    <nVectors>32</nVectors>
    <nDim>16</nDim>
    <nOutput>16</nOutput>
    <invertible>true</invertible>
  </ConceptualSpace>
  <WholeSpace>
    <lexer>word</lexer>
    <nInput>16</nInput>
    <nVectors>16</nVectors>
    <nDim>16</nDim>
    <nOutput>16</nOutput>
    <analysis>meronomy</analysis>
    <digitWholes>false</digitWholes>
    <divideWithinWhole>false</divideWithinWhole>
  </WholeSpace>
  <OutputSpace>
    <lrScale>10</lrScale>
    <nInput>16</nInput>
    <nVectors>1</nVectors>
    <nOutput>1</nOutput>
  </OutputSpace>
  <SymbolSpace>
    <language>
      <grammar>field.grammar</grammar>
    </language>
  </SymbolSpace>
</model>
