<?xml version="1.0"?>
<!--
  shamatha grammar, role-only format. Same C / S operator set as
  default.grammar. Declares ONLY operator roles (op_argin[n] inputs,
  op_argout1 output).

  RELOCATED 2026-07-12 to complete.grammar's operator form, exactly as in
  default.grammar: relations (part / equal) are structural operators whose
  checked thought faces derive from the same grammar declarations.
  See default.grammar's header for the measurement history.
-->
<grammar name="shamatha">

  <PartSpace>
    <!-- Analyzer root U; marker-free structural cover. Contiguity-aware
         meronymic ops are added when doc/plans/2026-04-28-shamatha-speech-
         contiguity-handoff.md is implemented. -->
    <start name="everything">U</start>
    <Synthesize>
      <rule>U = stop.forward(U)</rule>
      <rule>U = boundary.forward(U, U)</rule>
      <rule>U = uniform.forward(U, U)</rule>
    </Synthesize>
    <Analyze>
      <rule>U = stop.reverse(U)</rule>
      <rule>U, U = boundary.reverse(U)</rule>
      <rule>U, U = uniform.reverse(U)</rule>
    </Analyze>
  </PartSpace>

  <Symbolic>
    <start name="relative_truth">equal_argout1</start>
    <start name="relative_truth">part_argout1</start>

    <compose>
      <!-- Typed attention candidates; no predefined surface or generate face. -->
      <rule operands="field">F = divide.forward(F)</rule>
      <rule operands="field">F = descend.forward(F)</rule>
      <rule operands="field">F = gloss.forward(F)</rule>
      <rule operands="field">F = and.forward(F)</rule>
      <rule operands="field">F = or.forward(F)</rule>

      <rule>union_argout1 = union.forward(union_argin1, union_argin2)</rule>
      <rule>intersection_argout1 = intersection.forward(intersection_argin1, intersection_argin2)</rule>
      <rule>lift_argout1 = lift.forward(lift_argin1, lift_argin2)</rule>
      <rule>lower_argout1 = lower.forward(lower_argin1, lower_argin2)</rule>
      <rule>not_argout1 = not.forward(not_argin1)</rule>
      <rule>conjunction_argout1 = conjunction.forward(conjunction_argin1, conjunction_argin2)</rule>
      <rule>disjunction_argout1 = disjunction.forward(disjunction_argin1, disjunction_argin2)</rule>
      <rule>part_argout1 = part.forward(part_argin1, part_argin2)</rule>
      <rule>equal_argout1 = equal.forward(equal_argin1, equal_argin2)</rule>
    </compose>

<thought>
      <rule>ask_argout1 = ask.thought(ask_argin1)</rule>
      <rule>query_argout1 = query.thought(query_argin1)</rule>
      <rule>part_argout1 = part.thought(part_argin1, part_argin2)</rule>
      <rule family="part" permutation="argin2,argin1">whole_argout1 = whole.thought(whole_argin1, whole_argin2)</rule>
      <rule>equal_argout1 = equal.thought(equal_argin1, equal_argin2)</rule>
      <rule>not_argout1 = not.thought(not_argin1)</rule>
      <rule>bind_argout1 = bind.thought(bind_argin1)</rule>
      <rule>isTrue_argout1 = isTrue.thought(isTrue_argin1)</rule>
      <rule>exist_argout1 = exist.thought(exist_argin1)</rule>
      <rule>isPart_argout1 = isPart.thought(isPart_argin1, isPart_argin2)</rule>
      <rule>isEqual_argout1 = isEqual.thought(isEqual_argin1, isEqual_argin2)</rule>
      <rule>isImplied_argout1 = isImplied.thought(isImplied_argin1, isImplied_argin2)</rule>
      <rule>implies_argout1 = implies.thought(implies_argin1, implies_argin2)</rule>
      <rule>gain_argout1 = gain.thought(gain_argin1)</rule>
    </thought>

    <generate>
      <rule>union_argin1, union_argin2 = union.reverse(union_argout1)</rule>
      <rule>intersection_argin1, intersection_argin2 = intersection.reverse(intersection_argout1)</rule>
      <rule>lift_argin1, lift_argin2 = lift.reverse(lift_argout1)</rule>
      <rule>lower_argin1, lower_argin2 = lower.reverse(lower_argout1)</rule>
      <rule>not_argin1 = not.reverse(not_argout1)</rule>
      <rule>conjunction_argin1, conjunction_argin2 = conjunction.reverse(conjunction_argout1)</rule>
      <rule>disjunction_argin1, disjunction_argin2 = disjunction.reverse(disjunction_argout1)</rule>
      <rule>equal_argin1, equal_argin2 = equal.reverse(equal_argout1)</rule>
      <rule>part_argin1, part_argin2 = part.reverse(part_argout1)</rule>
    </generate>
  </Symbolic>

</grammar>
