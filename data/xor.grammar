<?xml version="1.0"?>
<!--
  XOR grammar, role-only format. Declares ONLY operator roles: each operand's
  input role (op_argin[n]) and the operator's output role (op_argout1). Forward maps inputs to output
  (argout1 = op.forward(argin1, argin2)); reverse maps output back to inputs
  (argin1, argin2 = op.reverse(argout1)).
-->
<grammar name="xor">

  <PartSpace>
    <!-- The analyzer root: U is "everything currently visible to the
         analyzer", recursively decomposable into U-typed sub-surfaces.
         The marker-free structural cover (stop / boundary / uniform) is
         the compatibility analyzer mode. compose = parts to whole
         (PS reverse / synthesis); generate = whole to parts (PS forward
         / analysis). -->
    <start name="everything">U</start>
    <Synthesize>
      <rule>U = stop.forward(U)</rule>
      <rule>U = boundary.forward(U, U)</rule>
      <rule>U = uniform.forward(U, U)</rule>
    </Synthesize>
    <Analyze>
      <rule>U = stop.reverse(U)</rule>
      <rule>U, U = boundary.reverse(U)</rule>
      <rule>U, U = uniform.reverse(U)</rule>
    </Analyze>
  </PartSpace>

  <Symbolic>
    <!-- Minimal XOR symbolic grammar: each connective declares its input
         roles (op_argin[n]) and output role (op_argout1); the operator outputs are
         the start states. Tier / arity / invertibility derive from each
         operator's GrammarLayer subclass. -->
    <start name="connective">not_argout1</start>
    <start name="connective">intersection_argout1</start>
    <start name="connective">union_argout1</start>

    <compose>
      <!-- Typed attention candidates; no predefined surface or generate face. -->
      <rule operands="field">F = divide.forward(F)</rule>
      <rule operands="field">F = descend.forward(F)</rule>
      <rule operands="field">F = gloss.forward(F)</rule>
      <rule operands="field">F = and.forward(F)</rule>
      <rule operands="field">F = or.forward(F)</rule>

      <rule>not_argout1 = not.forward(not_argin1)</rule>
      <rule>intersection_argout1 = intersection.forward(intersection_argin1, intersection_argin2)</rule>
      <rule>union_argout1 = union.forward(union_argin1, union_argin2)</rule>
    </compose>

    <generate>
      <!-- Mirror of compose: output role back to input roles. -->
      <rule>not_argin1 = not.reverse(not_argout1)</rule>
      <rule>intersection_argin1, intersection_argin2 = intersection.reverse(intersection_argout1)</rule>
      <rule>union_argin1, union_argin2 = union.reverse(union_argout1)</rule>
    </generate>
  </Symbolic>

</grammar>
