<?xml version="1.0" encoding="utf-8"?>
<model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="model.xsd">
  <architecture>
    <data><dataType>numeric</dataType><dataset>images</dataset><imageCorpus>shapes</imageCorpus></data>
    <conceptLayers>1</conceptLayers><bindingDepth>3</bindingDepth>
    <conceptBinding>aligned</conceptBinding>
    <attentionPromotion>true</attentionPromotion>
    <training><autoload>false</autoload><learningRate>0.005</learningRate><numEpochs>400</numEpochs></training>
  </architecture>
  <!-- A row-major 28 by 28 input, with a fixed six-coordinate percept cube.
       2048 ordinary concepts give order zero room for all 784 places;
       4096 basic percept seats accommodate distinct levels at those places. -->
  <InputSpace><nVectors>28</nVectors><nDim>44</nDim><nOutput>28</nOutput><nOutputDim>44</nOutputDim></InputSpace>
  <PartSpace><identityByParts>true</identityByParts><nInput>8</nInput><nInputDim>44</nInputDim>
    <nVectors>1024</nVectors><basicPerceptCapacity>4096</basicPerceptCapacity>
    <nDim>22</nDim><nOutput>8</nOutput><nOutputDim>22</nOutputDim>
    <invertible>true</invertible><synthesis>meronomy</synthesis><butterfly>true</butterfly></PartSpace>
  <ConceptualSpace><nInput>8</nInput><nInputDim>22</nInputDim><nVectors>2048</nVectors>
    <nDim>22</nDim><nOutput>8</nOutput><nOutputDim>22</nOutputDim><invertible>true</invertible><butterfly>true</butterfly></ConceptualSpace>
  <WholeSpace><analysis>meronomy</analysis><nInput>8</nInput><nInputDim>22</nInputDim>
    <nVectors>64</nVectors><nDim>22</nDim><nOutput>8</nOutput><nOutputDim>22</nOutputDim></WholeSpace>
  <OutputSpace><nInput>8</nInput><nInputDim>22</nInputDim><nVectors>10</nVectors><nOutput>10</nOutput></OutputSpace>
  <SymbolSpace><ltmCapacity>1024</ltmCapacity><language><start>S</start><grammar>field.grammar</grammar></language></SymbolSpace>
</model>
