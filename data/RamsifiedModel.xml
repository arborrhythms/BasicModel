<?xml version="1.0" ?>
<model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="model.xsd">
  <!-- RamsifiedModel: MentalModel with subsymbolicOrder=2.
       Used by test_reasoning.py::TestWriteMask::test_partition_isolation. -->
  <architecture>
    <bindingDepth>2</bindingDepth>
    <l1Lambda>0.01</l1Lambda>
    <!-- Stage 1.E: grammar config (non-substrate rules below) — per-word
         forward dispatch via _forward_body_per_word. -->
    <conceptLayers>2</conceptLayers>
    <weightsPath>RamsifiedModel.ckpt</weightsPath>
    <data>
      <dataType>embedding</dataType>
      <shardDir>data/fineweb</shardDir>
      <minFrequency>0.00001</minFrequency>
    </data>

    <training>
      <numEpochs>2</numEpochs>
      <reconstructionScale>0.1</reconstructionScale>
      <trainEmbedding>BACKPROP</trainEmbedding>
      <autoload>false</autoload>
    </training>

  </architecture>

  <SymbolSpace>
    <language>
      <grammar>
      <compose>
        <rule operands="field">F = divide.forward(F)</rule>
        <rule operands="field">F = descend.forward(F)</rule>
        <rule operands="field">F = gloss.forward(F)</rule>
        <rule operands="field">F = and.forward(F)</rule>
        <rule operands="field">F = or.forward(F)</rule>
        <rule>P = sigma(P)</rule>
        <rule>C = pi(C)</rule>
        <rule>S = sigma(S)</rule>
        <rule>S = swap(S, S)</rule>
        <rule>S = isEqual(S, S)</rule>
        <rule>S = part(S, S)</rule>
        <rule>S = non(S)</rule>
        <rule>S = not(S)</rule>
        <rule>S = intersection(S, S)</rule>
        <rule>S = union(S, S)</rule>
        <rule>S = lower(S, S)</rule>
        <rule>S = lift(S, S)</rule>
      </compose>
    </grammar>
    </language>
  </SymbolSpace>

  <InputSpace>
    <nDim>104</nDim>
    <nVectors>128</nVectors>
    <nOutput>128</nOutput>
    <codebook>quantize</codebook>
  </InputSpace>

  <PartSpace>
    <nOutput>128</nOutput>
    <nDim>104</nDim>
    <nVectors>256</nVectors>
  </PartSpace>

  <ConceptualSpace>
    <nOutput>128</nOutput>
    <nDim>104</nDim>
    <nVectors>128</nVectors>
    <invertible>true</invertible>
  </ConceptualSpace>

  <WholeSpace>
    <analysis>meronomy</analysis>
    <nOutput>128</nOutput>
    <nDim>104</nDim>
    <nVectors>128</nVectors>
  </WholeSpace>

  <OutputSpace>
    <nOutput>1</nOutput>
    <nDim>100</nDim>
    <nVectors>1</nVectors>
  </OutputSpace>

</model>
