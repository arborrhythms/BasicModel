<?xml version="1.0" ?>
<model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="model.xsd">
  <!-- MM_add_verb: the SYNTACTIC stage-0 fixture (Alec 2026-09-09): "3 plus 4"
       in, the one-hot 7 out, the input reconstructed; plus is a transitive
       VERB the grammar learns (complete.grammar verb / adverb VP ops), the
       numerals are nouns the lexicon learns, and no mathematical machinery
       runs in the model. MM_phrase_decode's topology (serial single-S idea,
       complete.grammar, WholeSpace word analysis, tall WS, ideaDecode) with
       the answer path on and R = 16 output vectors of width 1. Large: this
       is the "lots of training of a large network" run
       (doc/benchmarks/2026-09-09-math-thinking-pilot.md, "Stage 0 as
       syntax"). -->
  <architecture>
    <symbolicOrder>1</symbolicOrder>
    <subsymbolicOrder>3</subsymbolicOrder>
    <l1Lambda>0.01</l1Lambda>
    <sigmaPi>butterfly</sigmaPi>
    <mereologyRaise>true</mereologyRaise>
    <serialObjectMeta>true</serialObjectMeta>
    <symbolTower>true</symbolTower>
    <ideaDecode>true</ideaDecode>
    <answerSynthesis>true</answerSynthesis>

    <data>
      <dataType>embedding</dataType>
      <dataset>math</dataset>
      <mathStage>0</mathStage>
      <mathRange>16</mathRange>
      <mathProblems>2048</mathProblems>
      <mathSeed>0</mathSeed>
    </data>
    <training>
      <numEpochs>30</numEpochs>
      <batchSize>12</batchSize>
      <learningRate>0.01</learningRate>
      <reconstructionScale>0.1</reconstructionScale>
    </training>
  </architecture>

  <SymbolSpace>
    <language>
      <grammar>complete.grammar</grammar>
    </language>
  </SymbolSpace>

  <InputSpace>
    <nOutput>8192</nOutput>
    <nVectors>256</nVectors>
    <nDim>1024</nDim>
  </InputSpace>

  <PartSpace>
    <nInput>8192</nInput>
    <nInputDim>1024</nInputDim>
    <nVectors>65536</nVectors>
    <nDim>1024</nDim>
    <nOutput>8</nOutput>
    <nOutputDim>1024</nOutputDim>

    <invertible>true</invertible>
    <synthesis>radix</synthesis>
  </PartSpace>

  <ConceptualSpace>
    <nInput>8</nInput>
    <nInputDim>1024</nInputDim>
    <nVectors>8</nVectors>
    <stmCapacity>8</stmCapacity>
    <nDim>1024</nDim>
    <nOutput>8</nOutput>
    <nOutputDim>1024</nOutputDim>

    <invertible>true</invertible>
  </ConceptualSpace>

  <WholeSpace>
    <lexer>raw</lexer>
    <!-- Word analyzer: WS splits the surface on whitespace/punctuation into
         word brackets (_staged_analysis_spans), codetermining the words with
         the PS radix spell-out (Alec 2026-06-22: radix in PS is only good if
         words are codetermined PS<->WS by a word analyzer). Without it the
         serial loop is byte-grained (8 per-percept ideas, not 2 word-objects). -->
    <analysis>word</analysis>
    <nInput>8</nInput>
    <nInputDim>1024</nInputDim>
    <nVectors>65536</nVectors>
    <nDim>1024</nDim>
    <nOutput>1024</nOutput>
    <nOutputDim>1024</nOutputDim>

    <invertible>true</invertible>
    <codebook>quantize</codebook>
  </WholeSpace>

  <OutputSpace>
    <nInput>8</nInput>
    <nInputDim>1024</nInputDim>
    <nVectors>1</nVectors>
    <nDim>1</nDim>
    <nOutput>16</nOutput>
    <nOutputDim>1</nOutputDim>
  </OutputSpace>

</model>
