+def _sentence_query_mask(method):
+    """Keep registered and legacy query executors outside sentence work.
+
+    Permission is model-local, transient, and restored even when a sentence
+    path raises. Captured computation does not mutate this host flag: query
+    guards reject tracing directly, and the host input-execution wrapper
+    masks compiled calls and their eager islands. Nesting cannot let a called
+    boundary override an active sentence mask.
+    """
+    @wraps(method)
+    def masked(self, *args, **kwargs):
+        if torch.compiler.is_compiling():
+            return method(self, *args, **kwargs)
+        depth = self._query_sentence_depth
+        self._query_sentence_depth = depth + 1
+        try:
+            return method(self, *args, **kwargs)
+        finally:
+            self._query_sentence_depth = depth
+    return masked
 
 
