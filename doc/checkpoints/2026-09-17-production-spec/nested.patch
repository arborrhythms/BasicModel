+    def read_structure(self, reference, *, max_nodes=128, max_depth=16,
+                       max_records=1024):
+        """Read a bounded derived view of existing compound occurrences.
+
+        The registered slots and semantic sidecar remain the only owners.
+        Node, syntactic-depth and record-scan limits are separate. Repeated
+        role edges survive even when a shared node is visited only once.
+        Each row retains its own scope and evidence; parent support never
+        propagates to a reported claim or embedded question.
+        """
+        for name, value in (('max_nodes', max_nodes), ('max_depth', max_depth),
+                            ('max_records', max_records)):
+            if type(value) is not int or value < 0:
+                raise ValueError(f'{name} must be a non-negative integer')
+        if (not isinstance(reference, tuple) or len(reference) != 3
+                or reference[0] not in ('ltm', 'thought')
+                or not isinstance(reference[1], str)
+                or type(reference[2]) is not int or reference[2] < 0):
+            raise ValueError('structure requires an occurrence reference')
+        namespace = bytes(self._occurrence_namespace.tolist()).hex()
+        count = min(len(self), max_records)
+        indices = {int(self.occurrence_id[i]): i for i in range(count)}
+        incomplete, occurrences, rows, edges = [], [], [], []
+        visited, active = set(), set()
+        pending = [(reference, 0, False)]
+        while pending:
+            ref, depth, exiting = pending.pop()
+            if exiting:
+                active.remove(ref)
+                continue
+            if ref in active:
+                incomplete.append('cycle')
+                continue
+            if depth > max_depth:
+                incomplete.append('depth_limit')
+                continue
+            if ref in visited:
+                continue
+            if len(visited) >= max_nodes:
+                incomplete.append('node_limit')
+                continue
+            if ref[:2] != ('ltm', namespace):
+                incomplete.append('unavailable_owner')
+                continue
+            index = indices.get(ref[2])
+            if index is None:
+                incomplete.append('record_limit' if count < len(self)
+                                  else 'unavailable_reference')
+                continue
+            value = {key: item.detach().clone() if torch.is_tensor(item) else item
+                     for key, item in self.row(index).items()}
+            meaning = value['meaning']
+            if meaning is None:
+                incomplete.append('unavailable_metadata')
+                continue
+            visited.add(ref)
+            active.add(ref)
+            occurrences.append(ref)
+            rows.append(value)
+            children = self._occurrence_references(meaning)
+            edges.extend((ref, role, child) for role, child in children)
+            pending.append((ref, depth, True))
+            pending.extend((child, depth + 1, False)
+                           for _, child in reversed(children))
+        return {'occurrences': tuple(occurrences), 'rows': tuple(rows),
+                'edges': tuple(edges), 'records_scanned': count,
+                'incomplete': tuple(dict.fromkeys(incomplete))}
 
