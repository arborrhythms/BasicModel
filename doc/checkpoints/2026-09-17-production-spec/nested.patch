+    def retained_ltm_occurrences(self, namespace):
+        """Derive durable roots from all retained rows; no second reference index.
+
+        Scope, bindings and evidence sources can carry occurrence addresses too.
+        Looking up those addresses neither reads a tensor nor detaches live
+        episode credit. A finished thought remains a root while retained.
+        """
