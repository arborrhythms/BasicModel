+def test_sampling_temperature_changes_only_the_hard_draw(monkeypatch):
+    step = layer()
+    x = torch.tensor([[[1.], [2.], [3.]]])
+    noise = torch.tensor([[3., 0., 0., 0., 0., 0.]])
+    monkeypatch.setattr(torch, 'rand_like', lambda like:
