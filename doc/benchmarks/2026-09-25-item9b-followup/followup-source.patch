+    for fail in (False, True):
+        schedule = ModeSchedule('interleave:2')
+        schedule.pending = ['training tail']
+        model = SimpleNamespace(mode_schedule=schedule, _resume_batches_to_skip=resume)
+        seen = []
+        @scheduled_epoch
