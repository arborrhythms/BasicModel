            snapshots.append(dict(root=state[1][9].detach().clone(),
                activation=state[1][0].detach().clone(), meanings=result[2]['meanings'], entries=result[2]['entries']))
            return result
        monkeypatch.setattr(model,'_sentence_path_cost',cost)
