+    from SentenceUnderstanding import PrimedSymbols, SentenceUnderstanding
+    codes = torch.tensor([[[4., 0., 2., 0., 0., 0.], [0., 3., 0., 2., 0., 0.]],
+                          [[4., 0., 2., 0., 0., 0.], [0., 3., 0., 2., 0., 0.]]])
