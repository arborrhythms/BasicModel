+            if rule == 'min':
+                return torch.where(nonzero, values, 0.).amax(-1, keepdim=True)
+            result = torch.where(nonzero, values, torch.inf).amin(-1, keepdim=True)
+            return torch.where(nonzero.any(-1, keepdim=True), result, 0.)
+        if rule != 'mean':
