+def additive_language():
+    class Add:
+        inverse_kind = 'residual'
+        residual_scale = 1.
+        def compose(self, left, right):
+            return left + right
+    language = SimpleNamespace(_generate_binary_ops=(Add(),), _generate_unary_ops=(),
+        decomposition_chooser=DecompositionChooser())
