+            torch.ones(3, dtype=torch.bool), arity=2)
+        ids, arities, active = trace.choices()
+        assert ids[:, 0].tolist() == [[17, 23][i] for i in expected]
+        assert arities[:, 0].tolist() == [2, 2, 2]
+        assert active[:, 0].tolist() == [True, True, True]
