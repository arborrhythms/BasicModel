+    def _stage_reading_grammar_references(self, words, percepts):
+        """Stage the admitted word's OBJECT reference for every serial binding.
+
+        Reading already admitted these identities. Resolve their physical
+        rows once, at the eager boundary; grammar receives full codes without
+        consulting the lexicon or allocating another concept in its loop.
+        """
+        isp = self.inputSpace
+        active = getattr(isp, '_word_active_mask', None)
+        if not getattr(self, 'serial', False) or not torch.is_tensor(active):
+            return
+        B, W = active.shape
+        owner = self._concept_owner()
+        rows = torch.full_like(active, -1, dtype=torch.long)
+        word_ids, object_ids = rows.clone(), rows.clone()
+        word_orders, object_orders = rows.clone(), rows.clone()
+        offsets = getattr(isp, '_ar_word_part_offsets', None)
+        texts = percepts.get('word_texts')
+        word_major = torch.is_tensor(offsets) and offsets.ndim == 3 and texts is not None
+        starts = offsets[:, :, 0].detach().cpu().tolist() if word_major else None
+        loop_spans = percepts.get('part_spans')
+        loop_spans = (loop_spans.detach().cpu().tolist()
+                      if torch.is_tensor(loop_spans) else None)
+        active_host = active.detach().cpu().tolist()
+        anchors = getattr(self.languageSpace, '_surface_anchors', {})
+        forms = isp._ar_word_lexical_forms
+        for b, lo, hi, form, native_last, word_id, object_id in words:
+            if word_major:
+                columns = [p for p in range(W) if active_host[b][p]
+                           and starts[b][p] == lo and p < len(texts[b])
+                           and texts[b][p] == form]
+            elif loop_spans is not None:
+                columns = [p for p, (a, z) in enumerate(loop_spans[b][:W])
+                           if active_host[b][p] and lo <= a < z == hi]
+            else:
+                columns = [native_last] if native_last < W else []
+            if len(columns) != 1:
+                continue  # an unresolved/clipped percept cannot claim a word
+            p = columns[0]
+            if not active_host[b][p]:
+                continue
+            row = owner._csw_row_of(object_id)
+            if row is None:
+                continue
+            rows[b, p] = int(row)
+            word_ids[b, p], object_ids[b, p] = int(word_id), int(object_id)
+            word_orders[b, p] = int(owner._concept_source_order(word_id))
+            object_orders[b, p] = int(owner._concept_source_order(object_id))
+            if int(row) not in forms:
+                anchor = anchors.get(form.casefold())
+                forms[int(row)] = anchor if isinstance(anchor, str) else None
+        isp._ar_word_concept_rows = rows
+        isp._ar_word_concept_ids = word_ids
+        isp._ar_word_concept_orders = word_orders
+        isp._ar_word_object_rows = rows.clone()
+        isp._ar_word_object_ids = object_ids
+        isp._ar_word_object_orders = object_orders
+        bank_width = max(W, int(getattr(self, 'serial_word_capacity', 0) or 0),
+            max(tuple(getattr(self, 'serial_word_buckets', ()) or (0,))))
+        bank_rows = rows.new_full((B, 2 * bank_width), -1)
+        bank_rows[:, :W] = rows
+        bank_rows[:, bank_width:bank_width + W] = rows
+        atoms = owner.similarity_codebook.lookup_rows(bank_rows.clamp_min(0))
+        atoms = atoms * bank_rows.ge(0)[..., None].to(atoms.dtype)
+        isp._ar_concept_lookup_rows = bank_rows
+        isp._ar_concept_lookup_atoms = atoms
+        isp._ar_word_concept_atoms = atoms[:, :W].clone()
+        isp._ar_word_object_atoms = atoms[:, bank_width:bank_width + W].clone()
+        isp._finalize_sentence_word_layout(active)
+        sentence_ids = torch.full_like(bank_rows, -1)
+        sentence_ids[:, :W] = isp._packed_sentence_ids
+        sentence_ids[:, bank_width:bank_width + W] = isp._packed_sentence_ids
+        isp._ar_concept_lookup_sentence_ids = torch.where(
+            bank_rows >= 0, sentence_ids, torch.full_like(sentence_ids, -1))
