-_BIN = Path(__file__).resolve().parent
-if str(_BIN) not in sys.path:
-    sys.path.insert(0, str(_BIN))
-
-import Meronomy
-from Layers import WHITESPACE, WhereTilingLayer
-
-
-KIND_TYPED = 1
-KIND_WORD = 2
-KIND_SEPARATOR = 3
-KIND_SENTENCE = 4
