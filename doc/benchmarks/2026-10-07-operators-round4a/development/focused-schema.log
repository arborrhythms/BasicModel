        data_type = str(_data_sec.get("dataType")
                        or arch.get("dataType") or "numeric").strip().lower()
        is_embedding_mode = (data_type == "embedding")
        if (is_embedding_mode
                and not _ws_fold_bridged and not _ws_reshapes):
