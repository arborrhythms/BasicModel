        m._chart_compose_per_word = lambda: None
        chooser = m._stm_reducer().chooser
        score_unary = chooser.score_unary
        def no_exclusion(*args, **kwargs):
            stop, scores = score_unary(*args, **kwargs)
            if kwargs.get('op_offset') == m._stm_reducer().r_reduce + m._stm_reducer().r_apply:
                return stop, scores
            return stop, torch.full_like(scores, -torch.inf)
        chooser.score_unary = no_exclusion
        data = m.inputSpace.data
        saved_addresses = deepcopy(data.source_addresses["train"])
        for address in data.source_addresses["train"]:
            address["document"] = 0
            address["sentence"] = address["row"]
