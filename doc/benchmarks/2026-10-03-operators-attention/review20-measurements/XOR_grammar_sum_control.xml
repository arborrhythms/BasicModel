<?xml version="1.0" ?>
<model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="model.xsd">
  <!-- XOR_grammar: the composition mechanism gate (6.8 §12.1).
       Two words compose into one understanding, are decoded back, and an
       affine answer reads XOR. Conjunction is product binding; disjunction
       is the probabilistic sum of magnitudes times unit(x+y-x*y).
       Both binary rules are nonlinear. The separate sum control uses mean.
       No corpus tells this four-sentence fixture which operator a
       construction means; it does not measure grammatical learning.

       Inherits the always-on Pi/Sigma/Not folds from model.xml's
       tier-scoped defaults; the rules in <compose> below add the
       3-rule Boolean grammar at the symbolic tier. -->
  <architecture>
    <bindingDepth>2</bindingDepth>
    <!-- Native passes preserve width: every conceptual level keeps the
         same nVectors width (4+4+4 at order 2). Wide enough at each
         level to accommodate terminals and their negations
         (X1, NOT(X1), X2, NOT(X2)) as a tree-of-rules. The chart's
         single-root sentence-node bottleneck (chartCollapse=root in
         model.xml) forces the OutputLayer to read the chart's
         compositional commitment instead of recombining per-
         position copies via its own nonlinearity. -->
    <data>
      <dataType>embedding</dataType>
    </data>
    <!-- Stage 1.E: grammar config (non-substrate rules below) — per-word
         forward dispatch via _forward_body_per_word. -->
    <conceptLayers>2</conceptLayers>

    <training>
      <numEpochs>400</numEpochs>
      <learningRate>0.01</learningRate>
      <reconstructionScale>0.1</reconstructionScale>
      <trainEmbedding>JOINT</trainEmbedding>
      <embeddingScale>0.05</embeddingScale>
      <autoload>false</autoload>
    </training>
  </architecture>

  <!-- Capacity reduction (2026-05-01): the previous nDim=10,
       nVectors=8 setup gave the symbolic / conceptual / perceptual
       spaces 80 floats of representation each, which is enough to
       memorize the 4 (input, output) XOR pairs without needing the
       chart's compositional structure. Reduced to nDim=4, nVectors=2:
       2 symbol slots × 4 dims = 8 floats per space. With this tight
       budget the chart's grammar choice has to actually carry the
       function, exposing whether the inside+outside chart can solve
       XOR via its rule mixture.

       InputSpace stays at nVectors=8 because the tokenized strings
       (e.g. "hello world" -> 2 word tokens, padded) need that many
       slots. The shrink applies downstream of the input. -->

  <!-- Stage 1.D flat-slab invariant (2026-05-27): IS.nOutput aligned
       to PS/CS (6). nVectors stays at 8 for vocab headroom. -->
  <InputSpace>
    <nDim>14</nDim>
    <nVectors>8</nVectors>
    <nOutput>6</nOutput>
    <codebook>quantize</codebook>
  </InputSpace>

  <PartSpace>
    <nOutput>6</nOutput>
    <nDim>14</nDim>
    <nVectors>256</nVectors>
    <invertible>true</invertible>
  </PartSpace>

  <ConceptualSpace>
    <nOutput>6</nOutput>
    <nDim>14</nDim>
    <!-- §14 addendum: symbol/concept pairs only; letters stay in PS. -->
    <nVectors>6</nVectors>
    <invertible>true</invertible>
  </ConceptualSpace>

  <WholeSpace>
    <nOutput>6</nOutput>
    <!-- 2026-06-06 uniform-band migration: nDim is the EVENT width
         (nWhat + nWhere + nWhen). SS now carries (2, 2) like every other
         tier, so nDim was bumped 4 -> 8 to preserve nWhat=4. -->
    <nDim>14</nDim>
    <nVectors>9</nVectors>
  </WholeSpace>

  <OutputSpace>
    <nOutput>1</nOutput>
    <nVectors>1</nVectors>
  </OutputSpace>

  <SymbolSpace>
    <!-- Stage 3 cleanup: chartTau and routerKind retired alongside
         the chart. The signal router (LanguageLayer) is the canonical
         parser; no routing-kind dispatch is needed. -->
    <language>
      <!-- Tier-scoped grammar. The presence of <grammar> here means
           XOR_grammar.xml takes full ownership of the rule set; no
           merging with model.xml defaults. All rules live at the
           symbolic tier (XOR is a Boolean function over symbols). -->
      <grammar>
        <compose>
      <!-- Typed attention candidates; no predefined surface or generate face. -->
      <rule operands="field">F = divide.forward(F)</rule>
      <rule operands="field">F = descend.forward(F)</rule>
      <rule operands="field">F = gloss.forward(F)</rule>
      <rule operands="field">F = and.forward(F)</rule>
      <rule operands="field">F = or.forward(F)</rule>

          <symbols>
            <rule>S = sum.forward(S, S)</rule>
          </symbols>
        </compose>
      </grammar>
    </language>
  </SymbolSpace>

</model>
