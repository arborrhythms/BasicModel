            residual = (
                isp._ar_word_part_ids[:, p, :].to(word.dtype)
                * isp._ar_word_part_mask[:, p, :].to(word.dtype)
                + isp._ar_word_part_offsets[:, p, :].to(word.dtype)
            ).sum(dim=-1, keepdim=True)
            out_slot[p] = out_slot[p] + residual * 1e-6
