+    with torch.no_grad():
+        model.parameter.add_(7)
+        model.memory.rows.add_(10)
+    model._concept_allocator.next_id = 9
+    model._concept_allocator.identity[1] = 99
+    model.taxonomy.children[1].append(99)
+    model.taxonomy.priming.fill_(99)
+    model._category_learner.pending[1].fill_(99)
+    model._category_learner.step = 99
+    model.radix_trie.insert(b'car', 1)  # splits an existing mutable edge
+    model.inverse_table.append(b'car')
+    model.teacher.lesson.targets['clean'].fill_(99)
+    model.trace.actions.fill_(99)
+    model.errors.values['explore'] = [2.]
+    BasicModel._restore_compose_state(saved)
+    assert model.parameter.item() == 9
+    assert model.memory.rows.tolist() == [3.]
+    assert model._concept_allocator.next_id == 4
+    assert model._concept_allocator.identity == {1: 2}
+    assert model.taxonomy.children == {1: [2]}
+    assert model.taxonomy.priming.tolist() == [3.]
+    assert model._category_learner.pending[1].tolist() == [4.]
+    assert model._category_learner.step == 5
+    assert model.radix_trie.get(b'cat') == 0
+    assert model.radix_trie.get(b'car') is None
+    assert model.inverse_table == [b'cat']
+    assert model.teacher.lesson.targets['clean'].tolist() == [5.]
+    assert model.trace.actions.tolist() == [1]
+    assert model.errors.values == {'exploit': [1.]}
