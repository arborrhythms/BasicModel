+class Runtime(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.parameter = nn.Parameter(torch.tensor(2.))
+        self.memory = nn.Module()
+        self.memory.register_buffer('rows', torch.tensor([3.]))
+        self._concept_allocator = SimpleNamespace(_layers={}, next_id=4, identity={1: 2})
+        self.taxonomy = SimpleNamespace(children={1: [2]}, priming=torch.tensor([3.]))
+        self._category_learner = SimpleNamespace(pending={1: torch.tensor([4.])}, step=5)
+        from Layers import RadixTrie
+        self.radix_trie = RadixTrie()
+        self.radix_trie.insert(b'cat', 0)
+        self.inverse_table = [b'cat']
+        self.teacher = SimpleNamespace(lesson=Lesson({'clean': torch.tensor([5.])}))
+        self.errors = SimpleNamespace(values={'exploit': [1.]})
+        self.trace = SimpleNamespace(actions=torch.tensor([1]))
+
+    def _synthesis_state_objects(self):
+        return []
+
+    def _reconstruction_stack(self):
+        return self.trace
+
+    def _what_memory(self):
+        return self.memory
