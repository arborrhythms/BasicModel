+def test_sparse_topology_restore_retains_shared_learning_and_exploit_only_edges():
+    from Layers import SparseLayer
+    model = Runtime()
+    model.sparse = SparseLayer(4, 4)
+    matrix = model.sparse
+    matrix.add_edge(0, 1, weight=1.)
+    optimizer = torch.optim.Adam([matrix.values], lr=.01)
+    matrix._optimizer = optimizer
+    before = BasicModel._compose_state_snapshot(model)
+    def train(scale):
+        optimizer.zero_grad(set_to_none=True)
+        (matrix.values.sum() * scale).backward()
+        optimizer.step()
+    matrix.add_edge(1, 2, weight=2.)
+    train(1.)
+    committed = BasicModel._compose_state_snapshot(model)
+    exploit_value = matrix.values[1].detach().clone()
+    exploit_moment = optimizer.state[matrix.values]['exp_avg'][1].clone()
+    BasicModel._restore_compose_state(before)
+    assert matrix.nnz == len(matrix.values) == 1
+    # This alternative reuses the rolled-back allocation id but has a
+    # different meaning. Its value and optimizer history must stay ephemeral.
+    matrix.add_edge(2, 3, weight=3.)
+    train(2.)
+    shared_value = matrix.values[0].detach().clone()
+    shared_moment = optimizer.state[matrix.values]['exp_avg'][0].clone()
+    BasicModel._restore_compose_state(committed, sparse_scope=before)
+    assert list(zip(matrix._rows, matrix._cols)) == [(0, 1), (1, 2)]
+    assert matrix.nnz == len(matrix.values) == 2
+    torch.testing.assert_close(matrix.values, torch.stack((shared_value, exploit_value)))
+    torch.testing.assert_close(optimizer.state[matrix.values]['exp_avg'],
+                               torch.stack((shared_moment, exploit_moment)))
+    owned = [p for group in optimizer.param_groups for p in group['params']]
+    assert len(owned) == 1 and owned[0] is matrix.values
+
